#!/usr/bin/env python3
"""
Autonomous Health & Telemetry Monitor for Companion Computer
Reads high-rate MAVLink telemetry, computes real-time thrust reserve,
and monitors thermal/battery thresholds for safe heavy-payload flight.
"""

import time
import sys
from pymavlink import mavutil

class HeavyQuadHealthMonitor:
    def __init__(self, connection_string="/dev/ttyTHS1", baudrate=921600):
        print(f"[INFO] Connecting to Flight Controller on {connection_string} @ {baudrate} baud...")
        self.master = mavutil.mavlink_connection(connection_string, baud=baudrate)
        self.master.wait_heartbeat()
        print(f"[SUCCESS] Heartbeat received from System {self.master.target_system} (Component {self.master.target_component})")

        self.voltage = 0.0
        self.current = 0.0
        self.thrust_sp = 0.0
        self.failsafe_triggered = False

    def request_data_streams(self):
        # Request system status and actuator outputs at 10Hz
        message_ids = [
            (mavutil.mavlink.MAVLINK_MSG_ID_SYS_STATUS, 10),
            (mavutil.mavlink.MAVLINK_MSG_ID_ACTUATOR_OUTPUTS, 10),
            (mavutil.mavlink.MAVLINK_MSG_ID_ATTITUDE, 20)
        ]
        for msg_id, rate in message_ids:
            self.master.mav.command_long_send(
                self.master.target_system, self.master.target_component,
                mavutil.mavlink.MAV_CMD_SET_MESSAGE_INTERVAL, 0,
                msg_id, 1e6 / rate, 0, 0, 0, 0, 0
            )

    def monitor_loop(self):
        self.request_data_streams()
        print("[INFO] Monitoring telemetry streams. Press Ctrl+C to abort.")

        while True:
            msg = self.master.recv_match(blocking=True, timeout=1.0)
            if not msg:
                continue

            msg_type = msg.get_type()

            if msg_type == "SYS_STATUS":
                self.voltage = msg.voltage_battery / 1000.0  # mV to V
                self.current = msg.current_battery / 100.0   # 10mA to A
                power_w = self.voltage * self.current

                # Battery protection check: 12S threshold = 42.0V
                if self.voltage < 42.0 and not self.failsafe_triggered:
                    print(f"[CRITICAL WARNING] Low Battery Voltage: {self.voltage:.2f}V! RTL recommended.")
                    self.failsafe_triggered = True

            elif msg_type == "ACTUATOR_OUTPUTS":
                # Average PWM or DShot command across 4 primary motors
                outputs = [msg.output[i] for i in range(4)]
                avg_throttle_norm = (sum(outputs) / 4.0 - 1000) / 1000.0
                thrust_margin_pct = (1.0 - max(0.0, avg_throttle_norm)) * 100.0

                if avg_throttle_norm > 0.85:
                    print(f"[WARNING] High Hover Throttle ({avg_throttle_norm*100:.1f}%)! Thrust margin degraded ({thrust_margin_pct:.1f}%).")

            time.sleep(0.01)

if __name__ == "__main__":
    monitor = HeavyQuadHealthMonitor()
    try:
        monitor.monitor_loop()
    except KeyboardInterrupt:
        print("\n[INFO] Telemetry loop terminated safely.")
        sys.exit(0)
